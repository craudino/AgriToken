{
  "name": "cpr-digital",
  "version": "0.1.0",
  "private": true,
  "description": "MVP CPR Digital — raiz do monorepo. Ferramental de validação dos contratos congelados da Fase 0.",
  "type": "module",
  "scripts": {
    "validar:openapi": "redocly lint --config infra/ci/redocly.yaml && node infra/ci/validar-openapi.mjs",
    "validar:eventos": "node infra/ci/validar-eventos.mjs",
    "validar:esquema": "bash infra/ci/validar-esquema.sh",
    "validar:contratos": "node infra/ci/validar-abis.mjs",
    "validar": "npm run validar:openapi && npm run validar:eventos && npm run validar:contratos && npm run validar:p7 && npm run validar:esquema",
    "validar:p7": "node infra/ci/validar-p7.mjs",
    "construir": "tsc -b packages/nucleo services/compliance services/oracle services/core services/eudr infra/simulador-registradora",
    "bd:subir": "bash infra/db/subir-local.sh",
    "bd:aplicar": "bash infra/db/aplicar.sh",
    "bd:semear": "node --experimental-strip-types infra/dados/semear.ts",
    "dev": "node infra/orquestrar.mjs",
    "demo": "node infra/demo/executar.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "solc": "0.8.28",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "infra/simulador-registradora"
  ],
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
